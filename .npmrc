# @vercel/analytics declares an optional peer on @sveltejs/kit, which npm tries to
# resolve even in a React project; SvelteKit then demands TypeScript 5 while
# react-scripts 5 pins TypeScript 4, producing a spurious ERESOLVE.
#
# This must stay committed: Vercel runs `npm install` at build time and would hit
# the same conflict without it.
legacy-peer-deps=true
