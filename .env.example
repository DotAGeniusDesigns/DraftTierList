# Copy to .env.local for local development, and set the same variables in
# Vercel (Project Settings -> Environment Variables) for deploys.
#
# .env* is already gitignored — never commit real values.

# --- Database (required) -----------------------------------------------------
# Neon connection string. Create a free project at https://neon.tech, then copy
# the *pooled* connection string from the dashboard.
# The schema creates itself on the first API request — there is no migration
# step to run.
DATABASE_URL="postgresql://user:password@ep-xxx-pooler.region.aws.neon.tech/neondb?sslmode=require"

# --- Sessions (required) -----------------------------------------------------
# Signs the session cookie. Must be at least 32 characters.
# Generate one with:  node -e "console.log(require('crypto').randomBytes(48).toString('base64url'))"
# Changing this signs everyone out. Never reuse it across projects.
SESSION_SECRET="replace-me-with-a-long-random-string-at-least-32-chars"

# --- Email (required in production) ------------------------------------------
# Resend API key from https://resend.com/api-keys.
# If unset, password-reset emails are printed to the server console instead of
# being sent — fine locally, refused in production so resets can't fail silently.
RESEND_API_KEY=""

# Sender address on the verified Resend domain. Production refuses to start
# with the shared onboarding@resend.dev sender.
EMAIL_FROM="Fantasy Toolkit <accounts@mail.fantasy-toolkit.com>"

# --- Optional ----------------------------------------------------------------
# Name used in email subject lines and bodies.
APP_NAME="Fantasy Toolkit"

# Pins links inside production emails to the canonical origin.
PUBLIC_SITE_URL="https://fantasy-toolkit.com"
