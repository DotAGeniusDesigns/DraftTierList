# ------------------------------------------------------------------- python
# scripts/analysis/ is Python. Its own .gitignore covers the data those scripts
# generate; this covers interpreter and environment litter anywhere in the tree.
__pycache__/
*.py[cod]
*.egg-info/
.venv/
venv/
.ipynb_checkpoints/
.pytest_cache/
.mypy_cache/
.ruff_cache/

# --------------------------------------------------------------- data caches
# Raw feed downloads: Sleeper, nflverse play-by-play, participation, NGS, PFR,
# FTN, injuries, contracts. Several hundred MB, every byte of it re-fetchable by
# the generator that wanted it. `npm run stats` and the scripts in
# scripts/analysis/ all read through this directory and will refill it on demand.
#
# Listed explicitly rather than relying on the bare `.cache` entry that used to
# sit under the parcel section — that caught this directory by accident, which is
# a fragile way to keep a few hundred megabytes out of a repo.
.cache/
.cache

# ------------------------------------------------------- generated, not source
# Rebuild with scripts/buildPhotoMapFromSleeper.js.
scripts/playerPhotoMap.json

# FantasyPros export snapshots used to seed rankings
# (scripts/generatePlayerDatabase.js) — not meant for redistribution, and they go
# stale fast. Re-export from FantasyPros when needed.
FantasyPros/

# NOTE: src/utils/playerStats.js, injuryReport.js, offseasonNews.js,
# playerDatabase.js and projectionModel.js are ALSO generated, and are tracked on
# purpose — the app imports them at build time, so a clean checkout has to work
# without anyone running a generator or holding an API key first.

